{
	"name": "@ryangarber/prisma-orm-extension-zod",
	"version": "0.2.11",
	"description": "Support for Zod types and validation in Prisma 8.",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"prisma",
		"postgres",
		"zod"
	],
	"author": "Ryan Garber <ryanmichaelgarber@gmail.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/ryangarber/prisma-orm-extension-zod.git"
	},
	"exports": {
		"./codec-types": "./dist/codec-types.mjs",
		"./codecs": "./dist/codecs.mjs",
		"./column-types": "./dist/column-types.mjs",
		"./control": "./dist/control.mjs",
		"./pack": "./dist/pack.mjs",
		"./runtime": "./dist/runtime.mjs",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"lint": "biome check --write",
		"test": "vitest run",
		"prepublishOnly": "pnpm build",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@prisma/orm-postgres": "8.0.0-rc.20",
		"@prisma/orm-toolchain": "8.0.0-rc.20",
		"@types/node": "^26.6.4",
		"temporal-zod": "0.8.0",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.0.0",
			"onFail": "download"
		}
	},
	"dependencies": {
		"ponyfill-temporal": "0.1.0",
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"@prisma/orm-postgres": "8.0.0-rc.20"
	}
}

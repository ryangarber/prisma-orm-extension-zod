{
	"name": "prisma-orm-extension-zod",
	"version": "0.3.1",
	"description": "Zod schemas for Prisma 8.",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"prisma",
		"prisma-orm-extension",
		"postgres",
		"zod"
	],
	"author": "Ryan Garber <ryanmichaelgarber@gmail.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/ryangarber/prisma-orm-extension-zod.git"
	},
	"exports": {
		"./codec-types": "./dist/codec-types.mjs",
		"./codecs": "./dist/codecs.mjs",
		"./column-types": "./dist/column-types.mjs",
		"./control": "./dist/control.mjs",
		"./pack": "./dist/pack.mjs",
		"./runtime": "./dist/runtime.mjs",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"lint": "biome check --write",
		"test": "vitest run",
		"prepublishOnly": "pnpm build",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@prisma/orm-postgres": "8.0.0-rc.23",
		"@prisma/orm-toolchain": "8.0.0-rc.23",
		"@types/node": "^26.6.6",
		"temporal-zod": "0.8.0",
		"tsdown": "^0.23.7",
		"typescript": "7.1.0-beta",
		"vitest": "^5.1.0"
	},
	"packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24 <27",
			"onFail": "download"
		}
	},
	"dependencies": {
		"ponyfill-temporal": "0.1.0",
		"zod": "^4.6.7"
	},
	"peerDependencies": {
		"@prisma/orm-postgres": "8.0.0-rc.23"
	}
}

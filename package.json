{
	"name": "prisma-orm-extension-zod",
	"version": "0.3.3",
	"description": "Zod schemas for Prisma 8.",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"prisma",
		"prisma-orm-extension",
		"postgres",
		"zod"
	],
	"author": "Ryan Garber <ryanmichaelgarber@gmail.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/ryangarber/prisma-orm-extension-zod.git"
	},
	"exports": {
		"./codec-types": "./dist/codec-types.mjs",
		"./codecs": "./dist/codecs.mjs",
		"./column-types": "./dist/column-types.mjs",
		"./control": "./dist/control.mjs",
		"./pack": "./dist/pack.mjs",
		"./runtime": "./dist/runtime.mjs",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"lint": "biome check --write",
		"test": "vitest run",
		"prepublishOnly": "pnpm build",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@prisma/orm-postgres": "8.0.0-rc.25",
		"@prisma/orm-toolchain": "8.0.0-rc.25",
		"@types/node": "^26.6.6",
		"temporal-zod": "0.8.0",
		"tsdown": "^0.23.7",
		"typescript": "7.1.0-beta",
		"vitest": "^5.1.1"
	},
	"packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24 <27",
			"onFail": "download"
		}
	},
	"dependencies": {
		"ponyfill-temporal": "0.1.0",
		"zod": "^4.6.7"
	},
	"peerDependencies": {
		"@prisma/orm-postgres": "8.0.0-rc.25"
	}
}
